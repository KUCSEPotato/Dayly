secrets/
credentials/

# Personal task records and database backups must stay local.
backend/data/
backups/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.dump
*.sql.gz
*.sql.zip
*.backup

# Logs and generated test/debug artifacts may include personal information.
*.log
*.log.*
logs/
playwright-report/
test-results/
.coverage
.coverage.*
htmlcov/
coverage/

# Dependencies and build/cache output.
.venv/
__pycache__/
.pytest_cache/
*.py[cod]
node_modules/
dist/
*.tsbuildinfo
.DS_Store
